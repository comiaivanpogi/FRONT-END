# ──────────────────────────────────────────────────────────────────
# Java / IDE build artifacts
# ──────────────────────────────────────────────────────────────────

# Compiled class files
*.class

# Log files
*.log

# Package files
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Output / build directories
out/
build/
dist/
target/
bin/

# ──────────────────────────────────────────────────────────────────
# IDE & Editor files
# ──────────────────────────────────────────────────────────────────

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Eclipse
.classpath
.project
.settings/
.metadata/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/
*.code-workspace

# ──────────────────────────────────────────────────────────────────
# OS generated files
# ──────────────────────────────────────────────────────────────────

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# ──────────────────────────────────────────────────────────────────
# Sensitive / environment files — NEVER commit these
# ──────────────────────────────────────────────────────────────────

.env
.env.*
*.env
secrets.properties
secret.properties
config.properties
credentials.*
application-secret.*
